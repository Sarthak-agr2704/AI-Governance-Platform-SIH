# AegisAI Environment Configuration

# Service Information
APP_NAME="AegisAI — Responsible AI Governance Platform"
APP_ENV=development
DEBUG=True

# Backend Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration
# Uses SQLite for local dev if DATABASE_URL is not set or set to sqlite
DATABASE_URL=sqlite:///./aegis.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://aegis_user:aegis_password@localhost:5432/aegis_db

# Security & Secrets
SECRET_KEY=dev_secret_key_change_in_production_32bytes_min

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
